---
import Icon from './Icon.astro';
import { SITE_CONFIG } from '../content/config';
import { whatsappLink } from '../utils/whatsapp';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const wa = whatsappLink(
  lang === 'es' ? 'Hola, necesito presupuesto de poda.' : 'Hi, I need a pruning quote.'
);
---

<div class="pb-safe fixed inset-x-0 bottom-0 z-50 border-t border-brand-100 bg-white/95 backdrop-blur-sm lg:hidden">
  <div class="grid grid-cols-2 gap-2 p-2">
    <a
      href={SITE_CONFIG.phoneHref}
      data-track="click_phone_sticky"
      class="flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-white text-base font-bold text-brand-700 ring-2 ring-brand-600"
    >
      <Icon name="phone" cls="h-5 w-5 shrink-0" />
      {lang === 'es' ? 'Llamar' : 'Call'}
    </a>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      data-track="click_whatsapp_sticky"
      class="flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-brand-600 text-base font-bold text-white"
    >
      <Icon name="whatsapp" cls="h-5 w-5 shrink-0" />
      WhatsApp
    </a>
  </div>
</div>
