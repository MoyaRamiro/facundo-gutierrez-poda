---
import Icon from './Icon.astro';
import type { LandingContent, Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  content: LandingContent;
}
const { content, lang } = Astro.props;
const title = lang === 'es' ? 'Lo que hago' : 'What I do';
---

<section id="servicios" class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
  <h2 class="font-display text-3xl font-bold uppercase tracking-wide text-neutral-900 sm:text-4xl">{title}</h2>
  <div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200">
    {
      content.services.map((s) => (
        <a
          href="#contacto"
          data-track={`click_service_cta_${s.id}`}
          class="group flex min-h-[76px] items-center gap-4 py-4"
        >
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-800 text-brand-50">
            <Icon name={s.icon} cls="h-6 w-6" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-lg font-bold leading-snug text-neutral-900">{s.title}</span>
            <span class="mt-0.5 block text-sm leading-snug text-neutral-600">{s.benefit}</span>
          </span>
          <Icon name="arrow" cls="h-5 w-5 shrink-0 text-brand-700 transition-transform group-hover:translate-x-1" />
        </a>
      ))
    }
  </div>
</section>
