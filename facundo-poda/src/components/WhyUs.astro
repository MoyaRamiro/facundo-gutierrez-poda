---
import Icon from './Icon.astro';
import type { LandingContent, Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  content: LandingContent;
}
const { content, lang } = Astro.props;
const title = lang === 'es' ? 'Por qué llamarme' : 'Why call me';
---

<section class="bg-brand-900 text-brand-50">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <h2 class="font-display text-3xl font-bold uppercase tracking-wide sm:text-4xl">{title}</h2>
    <dl class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        content.whyUs.map((item) => (
          <div>
            <dt class="flex items-center gap-2 text-base font-bold">
              <Icon name={item.icon} cls="h-5 w-5 shrink-0 text-brand-300" />
              {item.title}
            </dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-brand-100">{item.desc}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
